<script>
const KEY='abbasali_rent_prototype_v1';
let db={tenants:[],rents:[],dueTemplate:'',paidTemplate:'',months:'January,February,March,April,May,June,July,August,September,October,November,December'};
const AUTH_KEY='abbasali_local_accounts_v1';
let accounts=null,currentUser=null;
async function digestPassword(password){if(globalThis.crypto?.subtle){const bytes=new TextEncoder().encode(password);const hash=await crypto.subtle.digest('SHA-256',bytes);return 'sha256:'+Array.from(new Uint8Array(hash)).map(b=>b.toString(16).padStart(2,'0')).join('')}/* Offline file:// fallback; local prototype only, not secure authentication. */let h1=2166136261,h2=0x9e3779b9;for(let i=0;i<password.length;i++){const c=password.charCodeAt(i);h1=Math.imul(h1^c,16777619);h2=Math.imul(h2+c,2246822519);h2^=h2>>>13}return 'local:'+((h1>>>0).toString(16))+((h2>>>0).toString(16))}
function readAccounts(){try{accounts=JSON.parse(localStorage.getItem(AUTH_KEY)||'null')}catch(e){accounts=null}}
function showAuth(){document.getElementById('appMain').style.display='none';document.getElementById('authArea').style.display='block';document.getElementById('setupView').classList.toggle('hidden',!!accounts);document.getElementById('loginView').classList.toggle('hidden',!accounts)}
async function createAccounts(){
 const ou=val('setupOwnerUser').trim(),op=val('setupOwnerPass'),mu=val('setupManagerUser').trim(),mp=val('setupManagerPass');
 if(!ou||!mu||ou.toLowerCase()===mu.toLowerCase()){alert('দুটি আলাদা ইউজারনেম দিন।');return}
 if(op.length<8||mp.length<8){alert('দুই পাসওয়ার্ডই কমপক্ষে ৮ অক্ষরের হতে হবে।');return}
 if(!crypto?.subtle){alert('এই ব্রাউজারে নিরাপদ হ্যাশ সুবিধা নেই। আধুনিক Chrome/Edge ব্যবহার করুন।');return}
 accounts={owner:{username:ou,passwordHash:await digestPassword(op)},manager:{username:mu,passwordHash:await digestPassword(mp)}};
 localStorage.setItem(AUTH_KEY,JSON.stringify(accounts));document.getElementById('setupOwnerPass').value='';document.getElementById('setupManagerPass').value='';showAuth();alert('Owner ও Manager অ্যাকাউন্ট তৈরি হয়েছে। এখন লগইন করুন।');
}
async function login(){
 const u=val('loginUser').trim(),p=val('loginPass');const err=document.getElementById('loginError');
 if(!accounts){showAuth();return}
 const role=Object.keys(accounts).find(r=>accounts[r].username.toLowerCase()===u.toLowerCase());
 if(!role||accounts[role].passwordHash!==await digestPassword(p)){err.textContent='ইউজারনেম অথবা পাসওয়ার্ড সঠিক নয়।';return}
 currentUser={role,username:accounts[role].username};document.getElementById('loginPass').value='';err.textContent='';
 document.getElementById('authArea').style.display='none';document.getElementById('appMain').style.display='block';
 document.getElementById('signedInAs').textContent=(role==='owner'?'Owner':'Manager')+' · '+currentUser.username;
 document.getElementById('logoutBtn').classList.remove('hidden');
 document.querySelector('[data-tab="backup"]').classList.toggle('hidden',role!=='owner');
 document.querySelectorAll('[data-owner-only]').forEach(el=>el.classList.toggle('hidden',role!=='owner'));
 if(role!=='owner'&&document.getElementById('backup').classList.contains('active'))switchTab('dashboard');
}
function logout(){currentUser=null;document.getElementById('logoutBtn').classList.add('hidden');document.getElementById('signedInAs').textContent='';document.getElementById('appMain').style.display='none';showAuth()}
async function changeManagerPassword(){
 if(currentUser?.role!=='owner'){alert('শুধু Owner এই কাজ করতে পারবেন।');return}
 const p=val('newManagerPass'),c=val('confirmManagerPass');if(p.length<8){alert('পাসওয়ার্ড কমপক্ষে ৮ অক্ষরের হতে হবে।');return}if(p!==c){alert('দুটি পাসওয়ার্ড মিলছে না।');return}
 accounts.manager.passwordHash=await digestPassword(p);localStorage.setItem(AUTH_KEY,JSON.stringify(accounts));set('newManagerPass','');set('confirmManagerPass','');alert('Manager পাসওয়ার্ড পরিবর্তন হয়েছে।');
}

function load(){try{let x=JSON.parse(localStorage.getItem(KEY)||'null');if(x)db={...db,...x}}catch(e){}}
function persist(){localStorage.setItem(KEY,JSON.stringify(db));render()}
function money(n){return '৳'+Number(n||0).toLocaleString('en-US',{maximumFractionDigits:2})}
function val(id){return document.getElementById(id).value}
function num(id){return Math.max(0,Number(val(id)||0))}
function set(id,v){document.getElementById(id).value=v??''}
function switchTab(id){if(id==='backup'&&currentUser?.role!=='owner'){alert('ব্যাকআপ ও সেটিংস শুধু Owner ব্যবহার করতে পারবেন।');return}document.querySelectorAll('.panel').forEach(x=>x.classList.remove('active'));document.getElementById(id).classList.add('active');document.querySelectorAll('nav button').forEach(x=>x.classList.toggle('active',x.dataset.tab===id));}
document.querySelectorAll('nav button').forEach(b=>b.addEventListener('click',()=>switchTab(b.dataset.tab)));
function clearTenant(){['tenantId','tName','tPhone','tFlat','tRent','tAdvance','tOldDue','tWork','tCurrent','tPermanent','tNid','tFamily','tEmergency'].forEach(id=>set(id,''));set('tRent','0');set('tAdvance','0');set('tOldDue','0')}
function saveTenant(){let name=val('tName').trim();if(!name){alert('ভাড়াটিয়ার নাম লিখুন');return}let id=val('tenantId')||String(Date.now());let t={id,name,phone:val('tPhone'),flat:val('tFlat'),rent:num('tRent'),advance:num('tAdvance'),oldDue:num('tOldDue'),work:val('tWork'),current:val('tCurrent'),permanent:val('tPermanent'),nid:val('tNid'),family:val('tFamily'),emergency:val('tEmergency')};let i=db.tenants.findIndex(x=>x.id===id);if(i>=0)db.tenants[i]=t;else db.tenants.push(t);persist();clearTenant();alert('ভাড়াটিয়ার তথ্য সংরক্ষণ হয়েছে')}
function editTenant(id){let t=db.tenants.find(x=>x.id===id);if(!t)return;let map={tenantId:'id',tName:'name',tPhone:'phone',tFlat:'flat',tRent:'rent',tAdvance:'advance',tOldDue:'oldDue',tWork:'work',tCurrent:'current',tPermanent:'permanent',tNid:'nid',tFamily:'family',tEmergency:'emergency'};Object.entries(map).forEach(([a,b])=>set(a,t[b]));switchTab('tenants')}
function deleteTenant(id){if(!confirm('এই ভাড়াটিয়ার প্রোফাইল মুছবেন? সংরক্ষিত হিসাব থাকবে।'))return;db.tenants=db.tenants.filter(x=>x.id!==id);persist()}
function populateYears(){let s=document.getElementById('rYear');for(let y=2006;y<=2055;y++){let o=document.createElement('option');o.value=y;o.textContent=y;s.appendChild(o)}s.value='2006'}
function render(){let tr=document.getElementById('tenantRows');tr.innerHTML=db.tenants.length?db.tenants.map(t=>`<tr><td>${esc(t.name)}</td><td>${esc(t.flat)}</td><td>${money(t.rent)}</td><td>${esc(t.phone)}</td><td><button onclick="editTenant('${t.id}')">সম্পাদনা</button> <button onclick="deleteTenant('${t.id}')">মুছুন</button></td></tr>`).join(''):'<tr><td colspan="5" class="muted">এখনো কোনো ভাড়াটিয়া যোগ করা হয়নি।</td></tr>';
let sel=document.getElementById('rTenant'),old=sel.value;sel.innerHTML='<option value="">ভাড়াটিয়া নির্বাচন করুন</option>'+db.tenants.map(t=>`<option value="${t.id}">${esc(t.name)} — ${esc(t.flat)}</option>`).join('');if(db.tenants.some(t=>t.id===old))sel.value=old;
document.getElementById('rentRows').innerHTML=db.rents.length?db.rents.slice().reverse().map(r=>`<tr><td>${esc(r.tenantName)}</td><td>${esc(r.month)} ${r.year}</td><td>${money(r.total)}</td><td>${money(r.paid)}</td><td class="${r.remaining>0?'danger':'success'}">${money(r.remaining)}</td></tr>`).join(''):'<tr><td colspan="5" class="muted">কোনো হিসাব নেই।</td></tr>';
document.getElementById('statTenants').textContent=db.tenants.length;let now=db.rents.reduce((a,r)=>({due:a.due+r.total,paid:a.paid+r.paid,arrears:a.arrears+r.remaining}),{due:0,paid:0,arrears:0});document.getElementById('statDue').textContent=money(now.due);document.getElementById('statPaid').textContent=money(now.paid);document.getElementById('statArrears').textContent=money(now.arrears);
}
function esc(s){return String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
document.getElementById('rTenant').addEventListener('change',()=>{let t=db.tenants.find(x=>x.id===val('rTenant'));if(t){set('rRent',t.rent);set('rOldDue',t.oldDue)}});
function calculate(){let used=Math.max(0,num('rCurrent')-num('rPrev')),elec=used*num('rRate');let total=num('rRent')+num('rOldDue')+elec+num('rGas')+num('rWater')+num('rService')+num('rWaste')-num('rElecAdv');let remaining=Math.max(0,total-num('rPaid'));set('usedUnits',used);document.getElementById('usedUnits').textContent=used;document.getElementById('electricity').textContent=money(elec);document.getElementById('totalDue').textContent=money(Math.max(0,total));document.getElementById('remaining').textContent=money(remaining);return {used,elec,total:Math.max(0,total),remaining}}
function saveRent(){
 let t=db.tenants.find(x=>x.id===val('rTenant'));
 if(!t){alert('আগে ভাড়াটিয়া নির্বাচন করুন');return}
 let c=calculate();
 let r={id:String(Date.now()),tenantId:t.id,tenantName:t.name,month:val('rMonthName'),year:val('rYear'),rent:num('rRent'),oldDue:num('rOldDue'),meter:val('rMeter'),prev:num('rPrev'),current:num('rCurrent'),used:c.used,rate:num('rRate'),electricity:c.elec,elecAdv:num('rElecAdv'),gas:num('rGas'),water:num('rWater'),service:num('rService'),waste:num('rWaste'),paid:num('rPaid'),method:val('rMethod'),txn:val('rTxn'),total:c.total,remaining:c.remaining};
 let i=db.rents.findIndex(x=>x.tenantId===r.tenantId&&x.month===r.month&&String(x.year)===String(r.year));
 if(i>=0){
  if(!confirm('এই মাসের সংরক্ষিত হিসাব প্রতিস্থাপন করবেন?'))return;
  r.id=db.rents[i].id;
  db.rents[i]=r;
 }else db.rents.push(r);
 persist();
 alert('মাসিক হিসাব সংরক্ষণ হয়েছে');
}
function saveTemplates(){db.dueTemplate=val('dueTemplate');db.paidTemplate=val('paidTemplate');persist();alert('বার্তার টেমপ্লেট সংরক্ষণ হয়েছে')}
function makeMessage(type){let t=db.tenants.find(x=>x.id===val('rTenant'))||db.tenants[0];if(!t){alert('আগে ভাড়াটিয়া যোগ করুন');return}let c=calculate(),tpl=type==='due'?(val('dueTemplate')||db.dueTemplate):(val('paidTemplate')||db.paidTemplate);let msg=tpl.replaceAll('{নাম}',t.name).replaceAll('{মাস}',val('rMonthName')+' '+val('rYear')).replaceAll('{টাকা}',money(type==='due'?c.remaining:num('rPaid')));set('messageOutput',msg)}
function copyMessage(){let x=val('messageOutput');if(!x){alert('আগে বার্তা তৈরি করুন');return}navigator.clipboard?.writeText(x).then(()=>alert('বার্তা কপি হয়েছে')).catch(()=>{set('messageOutput',x);alert('বার্তাটি নির্বাচন করে কপি করুন')})}
function exportData(){let content=JSON.stringify(db,null,2),filename='abbasali-properties-backup-'+new Date().toISOString().slice(0,10)+'.json';if(window.AndroidBridge&&AndroidBridge.saveBackup){AndroidBridge.saveBackup(filename,content);return}let blob=new Blob([content],{type:'application/json'}),a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=filename;a.click();URL.revokeObjectURL(a.href)}
function importData(e){let f=e.target.files[0];if(!f)return;let rd=new FileReader();rd.onload=()=>{try{let x=JSON.parse(rd.result);if(!Array.isArray(x.tenants)||!Array.isArray(x.rents))throw Error();if(!confirm('বর্তমান ডাটা ব্যাকআপের ডাটা দিয়ে প্রতিস্থাপন করবেন? আগে বর্তমান ডাটার ব্যাকআপ নিন।'))return;db={...db,...x};persist();alert('ব্যাকআপ রিকভারি সম্পন্ন হয়েছে')}catch(err){alert('ফাইলটি সঠিক Abbasali ব্যাকআপ নয়।')}};rd.readAsText(f);e.target.value=''}
function saveMonths(){let m=val('monthsInput').split(',').map(x=>x.trim()).filter(Boolean);if(!m.length){alert('অন্তত একটি মাসের নাম দিন');return}db.months=m.join(',');persist();alert('কাস্টম মাসের নাম সংরক্ষণ হয়েছে')}
readAccounts();showAuth();document.getElementById('loginPass').addEventListener('keydown',e=>{if(e.key==='Enter')login()});document.getElementById('loginUser').addEventListener('keydown',e=>{if(e.key==='Enter')login()});load();populateYears();if(db.dueTemplate)set('dueTemplate',db.dueTemplate);if(db.paidTemplate)set('paidTemplate',db.paidTemplate);set('monthsInput',db.months);render();calculate();
</script>
</body>

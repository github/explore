<title>Abbasali Rent Manager — হাসনা হেনা ভিলা</title>
<style>
:root{--ink:#102b31;--muted:#61777b;--teal:#087e83;--teal2:#dff6f3;--bg:#f3f7f7;--line:#dce7e7;--white:#fff;--orange:#b76516;--red:#b42318;--green:#16804a}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font-family:system-ui,-apple-system,"Noto Sans Bengali",sans-serif}
header{background:#073c43;color:white;padding:18px max(16px,calc((100vw - 1100px)/2));display:flex;gap:14px;align-items:center;justify-content:space-between;flex-wrap:wrap}
.brand{display:flex;align-items:center;gap:12px}.mark{width:44px;height:44px;border-radius:14px;background:#c9f5eb;color:#07565a;display:grid;place-items:center;font-weight:900;font-size:20px}.brand h1{font-size:19px;margin:0}.brand small{color:#bde5df}
header .sub{font-size:12px;color:#d2e9e6}
main{max-width:1100px;margin:20px auto;padding:0 14px 48px}
nav{display:flex;gap:8px;overflow:auto;padding:4px 0 14px}nav button,.btn{border:1px solid var(--line);background:white;color:var(--ink);padding:10px 14px;border-radius:12px;font-weight:650;cursor:pointer;white-space:nowrap}nav button.active,.primary{background:var(--teal);color:white;border-color:var(--teal)}
button:focus,input:focus,select:focus,textarea:focus{outline:2px solid #62c7bd;outline-offset:1px}
.panel{display:none}.panel.active{display:block}
.card{background:white;border:1px solid var(--line);border-radius:18px;padding:17px;margin-bottom:14px;box-shadow:0 4px 16px #173b3b0a}
h2{font-size:20px;margin:0 0 14px}h3{font-size:16px;margin:0 0 12px}
.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.stat{background:white;border:1px solid var(--line);padding:15px;border-radius:16px}.stat span{display:block;color:var(--muted);font-size:13px}.stat strong{display:block;font-size:23px;margin-top:6px}
.formgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.field{display:flex;flex-direction:column;gap:5px}.field label{font-size:13px;color:var(--muted);font-weight:650}.field input,.field select,.field textarea{width:100%;border:1px solid #cbdada;border-radius:10px;padding:10px;background:white;color:var(--ink);font:inherit;min-width:0}.field textarea{min-height:76px}
.actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:14px}.muted{color:var(--muted);font-size:13px}.row{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}
table{width:100%;border-collapse:collapse;font-size:14px}th,td{text-align:left;padding:10px;border-bottom:1px solid var(--line)}th{color:var(--muted);font-weight:650}td button{padding:6px 9px;border:1px solid var(--line);border-radius:8px;background:white}
.pill{display:inline-block;background:var(--teal2);color:#075e61;padding:4px 9px;border-radius:99px;font-size:12px;font-weight:700}
.notice{background:#fff7e8;border:1px solid #f1d8a9;color:#70430d;padding:12px;border-radius:12px;font-size:13px}
.success{color:var(--green)}.danger{color:var(--red)}
hr{border:0;border-top:1px solid var(--line);margin:16px 0}
@media(max-width:760px){.grid{grid-template-columns:repeat(2,1fr)}.formgrid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:480px){.formgrid{grid-template-columns:1fr}.stat strong{font-size:19px}header{padding:14px}}

#appMain{display:none}.auth-wrap{max-width:520px;margin:28px auto;padding:0 14px 40px}.auth-card{background:#fff;border:1px solid var(--line);border-radius:18px;padding:22px;box-shadow:0 8px 28px #173b3b12}.auth-card h2{margin-bottom:8px}.auth-grid{display:grid;gap:12px}.auth-grid .field input{min-height:44px}.auth-note{margin-top:14px}.hidden{display:none!important}.userbar{display:flex;gap:10px;align-items:center;flex-wrap:wrap}.userbar button{border:1px solid #ffffff66;background:#ffffff12;color:#fff;padding:8px 12px;border-radius:10px;cursor:pointer}

/* Premium 2026 visual system */
:root{--ink:#14213d;--muted:#718096;--teal:#2457d6;--teal2:#e9efff;--bg:#f4f7fc;--line:#e2e8f2;--white:#fff;--orange:#b7791f;--red:#c53030;--green:#16845b;--navy:#101d42;--gold:#e6b94f}
body{background:radial-gradient(ellipse at 8% 0%,#eaf1ff 0,transparent 36%),linear-gradient(135deg,#f7f9fd,#eef3fb);color:var(--ink);font-family:system-ui,-apple-system,"Noto Sans Bengali",sans-serif;letter-spacing:.01em}
header{background:linear-gradient(112deg,#0d1940 0%,#173d91 58%,#1767bd 100%);padding:18px max(18px,calc((100vw - 1180px)/2));box-shadow:0 10px 32px #10285a22;border-bottom:1px solid #ffffff24}
.brand .mark{width:48px;height:48px;border-radius:16px;background:linear-gradient(145deg,#fff,#dce8ff);color:#173d91;box-shadow:inset 0 0 0 1px #ffffffa6,0 6px 18px #06153b55}
.brand h1{font-size:clamp(16px,2vw,21px);letter-spacing:.035em}.brand small{color:#d9e6ff}
main{max-width:1180px;margin:24px auto;padding:0 16px 56px}
nav{gap:9px;padding:5px 0 17px}nav button,.btn{border:1px solid #dce5f4;background:#fff;color:#33415f;padding:11px 16px;border-radius:13px;font-weight:700;box-shadow:0 3px 12px #1a39700a;transition:transform .16s,box-shadow .16s,border-color .16s}nav button:hover,.btn:hover{transform:translateY(-1px);box-shadow:0 8px 20px #1a397015;border-color:#b9c9e8}nav button.active,.primary{background:linear-gradient(135deg,#2457d6,#3479ed);color:white;border-color:#2457d6;box-shadow:0 7px 18px #2457d633}
.card,.auth-card{background:#ffffffed;border:1px solid #e1e8f4;border-radius:20px;padding:20px;margin-bottom:16px;box-shadow:0 12px 32px #18366d0b,0 2px 6px #18366d07;backdrop-filter:blur(8px)}
h2{font-size:21px;letter-spacing:-.02em}h3{font-size:16px;color:#26385f}
.grid{gap:14px}.stat{background:linear-gradient(145deg,#fff,#f7f9ff);border:1px solid #e0e8f6;padding:18px;border-radius:18px;box-shadow:0 6px 20px #15366e0a}.stat span{color:#71809a}.stat strong{font-size:clamp(21px,2.2vw,27px);color:#193d91}
.formgrid{gap:14px}.field{gap:7px}.field label{color:#52627f}.field input,.field select,.field textarea{border:1px solid #d5deee;border-radius:12px;padding:11px 12px;background:#fbfcff;color:#17264a;transition:border-color .15s,box-shadow .15s}.field input:focus,.field select:focus,.field textarea:focus{border-color:#5c88e8;box-shadow:0 0 0 3px #dce7ff;outline:0}
.actions{gap:10px}.actions button{border-radius:12px;padding:11px 15px}table{font-size:14px;border-collapse:separate;border-spacing:0;overflow:hidden;border:1px solid #e2e9f4;border-radius:14px}th,td{padding:12px 11px;border-bottom:1px solid #e9eef6}th{background:#f2f6fd;color:#536482}tbody tr:hover{background:#f8faff}.pill{background:#e8efff;color:#234baf;padding:5px 11px}.notice{background:#fff9eb;border:1px solid #f3dfb5;color:#77521b;border-radius:14px;padding:14px}.auth-wrap{max-width:560px;margin:34px auto}.auth-card{padding:26px}.userbar button{border-radius:11px}
@media(max-width:760px){main{margin:14px auto;padding:0 12px 36px}header{padding:14px 16px}.card{padding:15px}.grid{gap:10px}}
@media(max-width:480px){.formgrid{grid-template-columns:1fr}.stat{padding:13px}.stat strong{font-size:19px}nav button{padding:10px 12px}}


.welcome-art{padding:0;overflow:hidden}.welcome-art img{display:block;width:100%;height:auto;max-height:340px;object-fit:cover}
</style>
</head>
<body>
<header>
 <div class="brand"><div class="mark">⌂</div><div><h1>হাসনা হেনা ভিলা</h1><small>স্মার্ট ভাড়াটিয়া ও ভাড়া ব্যবস্থাপনা</small></div></div>
 <div class="userbar"><div class="sub">আবাস আলী এন্টারপ্রাইজ · নিরাপদ আবাসন</div><span id="signedInAs" class="sub"></span><button id="logoutBtn" class="hidden" onclick="logout()">লগআউট</button></div>
</header>
<section id="authArea" class="auth-wrap">
 <div class="auth-card">
  <div id="setupView" class="hidden">
   <h2>প্রথমবার অ্যাকাউন্ট তৈরি</h2><p class="muted">প্রতিষ্ঠানের Owner এবং নির্ধারিত Manager-এর আলাদা লগইন তৈরি করুন। ইউজারনেম ও পাসওয়ার্ড নিজেরা নির্ধারণ করুন।</p>
   <div class="auth-grid">
    <h3>Owner অ্যাকাউন্ট</h3>
    <div class="field"><label>Owner ইউজারনেম</label><input id="setupOwnerUser" autocomplete="username" placeholder="যেমন: owner"></div>
    <div class="field"><label>Owner পাসওয়ার্ড (কমপক্ষে ৮ অক্ষর)</label><input id="setupOwnerPass" type="password" autocomplete="new-password"></div>
    <hr><h3>Manager অ্যাকাউন্ট</h3>
    <div class="field"><label>Manager ইউজারনেম</label><input id="setupManagerUser" autocomplete="off" placeholder="যেমন: manager"></div>
    <div class="field"><label>Manager পাসওয়ার্ড (কমপক্ষে ৮ অক্ষর)</label><input id="setupManagerPass" type="password" autocomplete="new-password"></div>
    <button class="primary" onclick="createAccounts()">অ্যাকাউন্ট তৈরি করুন</button>
   </div>
  </div>
  <div id="loginView" class="hidden">
   <h2>লগইন করুন</h2><p class="muted">হাসনা হেনা ভিলা ব্যবহারের জন্য আপনার অ্যাকাউন্টে প্রবেশ করুন।</p>
   <div class="auth-grid">
    <div class="field"><label>ইউজারনেম</label><input id="loginUser" autocomplete="username"></div>
    <div class="field"><label>পাসওয়ার্ড</label><input id="loginPass" type="password" autocomplete="current-password"></div>
    <button class="primary" onclick="login()">লগইন</button>
    <p id="loginError" class="danger" role="alert"></p>
   </div>
  </div>
  <div class="notice auth-note">ডেমো সতর্কতা: এই সংস্করণের লগইন একই ডিভাইসের ব্রাউজারে কাজ করে। এটি সার্ভার-ভিত্তিক নিরাপত্তা নয়; বাস্তব NID/ভাড়াটিয়া তথ্য রাখার আগে নিরাপদ ক্লাউড ব্যাকএন্ড ও সার্ভার অথেনটিকেশন প্রয়োজন।</div>
 </div>
</section>
<main id="appMain">
<nav>
 <button class="active" data-tab="dashboard">ড্যাশবোর্ড</button>
 <button data-tab="tenants">ভাড়াটিয়া</button>
 <button data-tab="rent">মাসিক হিসাব</button>
 <button data-tab="messages">নোটিফিকেশন</button>
 <button data-tab="backup">ব্যাকআপ ও সেটিংস</button>
</nav>

<section id="dashboard" class="panel active">
 <div class="card welcome-art"><img src="data:image/svg+xml;charset=utf-8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%221200%22%20height%3D%22360%22%20viewBox%3D%220%200%201200%20360%22%3E%3Cdefs%3E%3ClinearGradient%20id%3D%22g%22%20x1%3D%220%22%20y1%3D%220%22%20x2%3D%221%22%20y2%3D%221%22%3E%3Cstop%20stop-color%3D%22%230d1940%22%2F%3E%3Cstop%20offset%3D%22.58%22%20stop-color%3D%22%23173d91%22%2F%3E%3Cstop%20offset%3D%221%22%20stop-color%3D%22%231767bd%22%2F%3E%3C%2FlinearGradient%3E%3C%2Fdefs%3E%3Crect%20width%3D%221200%22%20height%3D%22360%22%20rx%3D%2228%22%20fill%3D%22url%28%23g%29%22%2F%3E%3Cg%20fill%3D%22none%22%20stroke%3D%22%23ffffff%22%20stroke-opacity%3D%22.22%22%20stroke-width%3D%223%22%3E%3Cpath%20d%3D%22M760%20360V180l130-100%20130%20100v180M830%20360V210h120v150M1020%20360V235h90v125%22%2F%3E%3Cpath%20d%3D%22M700%20360V245l60-45%2060%2045v115%22%2F%3E%3C%2Fg%3E%3Cg%20fill%3D%22%23fff%22%3E%3Ctext%20x%3D%2265%22%20y%3D%22120%22%20font-family%3D%22sans-serif%22%20font-size%3D%2230%22%20opacity%3D%22.8%22%3E%E0%A6%86%E0%A6%AC%E0%A7%8D%E0%A6%AC%E0%A6%BE%E0%A6%B8%20%E0%A6%86%E0%A6%B2%E0%A7%80%20%E0%A6%8F%E0%A6%A8%E0%A7%8D%E0%A6%9F%E0%A6%BE%E0%A6%B0%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%BE%E0%A6%87%E0%A6%9C%3C%2Ftext%3E%3Ctext%20x%3D%2265%22%20y%3D%22205%22%20font-family%3D%22sans-serif%22%20font-size%3D%2264%22%20font-weight%3D%22700%22%3E%E0%A6%B9%E0%A6%BE%E0%A6%B8%E0%A6%A8%E0%A6%BE%20%E0%A6%B9%E0%A7%87%E0%A6%A8%E0%A6%BE%20%E0%A6%AD%E0%A6%BF%E0%A6%B2%E0%A6%BE%3C%2Ftext%3E%3Ctext%20x%3D%2265%22%20y%3D%22265%22%20font-family%3D%22sans-serif%22%20font-size%3D%2230%22%20opacity%3D%22.9%22%3E%E0%A6%B8%E0%A7%8D%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%9F%20%E0%A6%AD%E0%A6%BE%E0%A7%9C%E0%A6%BE%E0%A6%9F%E0%A6%BF%E0%A7%9F%E0%A6%BE%20%E0%A6%93%20%E0%A6%AD%E0%A6%BE%E0%A7%9C%E0%A6%BE%20%E0%A6%AC%E0%A7%8D%E0%A6%AF%E0%A6%AC%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A6%AA%E0%A6%A8%E0%A6%BE%3C%2Ftext%3E%3C%2Fg%3E%3Ccircle%20cx%3D%221100%22%20cy%3D%2270%22%20r%3D%2228%22%20fill%3D%22%23e6b94f%22%20opacity%3D%22.9%22%2F%3E%3C%2Fsvg%3E" alt="হাসনা হেনা ভিলা ও আবাস আলী এন্টারপ্রাইজের প্রচারচিত্র"></div>
 <div class="row"><div><h2>ড্যাশবোর্ড</h2><div class="muted">আপনার বাড়ি ও ভাড়ার সারসংক্ষেপ</div></div><span class="pill">January 2006 – December 2055</span></div>
 <div class="grid" style="margin:14px 0">
  <div class="stat"><span>মোট ভাড়াটিয়া</span><strong id="statTenants">0</strong></div>
  <div class="stat"><span>এই মাসের মোট দাবি</span><strong id="statDue">৳0</strong></div>
  <div class="stat"><span>এই মাসে আদায়</span><strong id="statPaid">৳0</strong></div>
  <div class="stat"><span>মোট বকেয়া</span><strong id="statArrears">৳0</strong></div>
 </div>
 <div class="card"><h3>দ্রুত কাজ</h3><div class="actions"><button class="primary" onclick="switchTab('tenants')">+ ভাড়াটিয়া যোগ করুন</button><button onclick="switchTab('rent')">মাসিক হিসাব লিখুন</button><button data-owner-only onclick="switchTab('backup')">ব্যাকআপ নিন</button></div></div>
 <div class="notice">ডেমো মোড: তথ্য এই ব্রাউজারের ডিভাইসে সংরক্ষিত হয়। গুরুত্বপূর্ণ বাস্তব তথ্য ব্যবহারের আগে ক্লাউড সার্ভার, লগইন, এনক্রিপশন ও আলাদা ব্যাকআপ চালু করতে হবে।</div>
</section>

<section id="tenants" class="panel">
 <div class="row"><h2>ভাড়াটিয়ার তথ্য</h2><span class="pill">নতুন / সম্পাদনা</span></div>
 <div class="card">
  <input type="hidden" id="tenantId">
  <div class="formgrid">
   <div class="field"><label>ভাড়াটিয়ার নাম *</label><input id="tName" placeholder="নাম লিখুন"></div>
   <div class="field"><label>মোবাইল নম্বর</label><input id="tPhone" inputmode="tel" placeholder="01XXXXXXXXX"></div>
   <div class="field"><label>রুম / ফ্ল্যাট নম্বর</label><input id="tFlat" placeholder="যেমন: ৩য় তলা-A"></div>
   <div class="field"><label>মাসিক ভাড়া (৳)</label><input id="tRent" type="number" min="0" value="0"></div>
   <div class="field"><label>অ্যাডভান্স / অগ্রিম (৳)</label><input id="tAdvance" type="number" min="0" value="0"></div>
   <div class="field"><label>পূর্বের বকেয়া (৳)</label><input id="tOldDue" type="number" min="0" value="0"></div>
   <div class="field"><label>পেশা / কর্মস্থল</label><input id="tWork"></div>
   <div class="field"><label>বর্তমান ঠিকানা</label><input id="tCurrent"></div>
   <div class="field"><label>স্থায়ী ঠিকানা</label><input id="tPermanent"></div>
   <div class="field"><label>এনআইডি নম্বর</label><input id="tNid"></div>
   <div class="field"><label>পরিবারের সদস্য সংখ্যা</label><input id="tFamily" type="number" min="0"></div>
   <div class="field"><label>জরুরি যোগাযোগ নম্বর</label><input id="tEmergency"></div>
  </div>
  <div class="actions"><button class="primary" onclick="saveTenant()">তথ্য সংরক্ষণ</button><button onclick="clearTenant()">ফরম পরিষ্কার</button></div>
 </div>
 <div class="card"><h3>ভাড়াটিয়ার তালিকা</h3><div style="overflow:auto"><table><thead><tr><th>নাম</th><th>ফ্ল্যাট</th><th>মাসিক ভাড়া</th><th>মোবাইল</th><th>কাজ</th></tr></thead><tbody id="tenantRows"><tr><td colspan="5" class="muted">এখনো কোনো ভাড়াটিয়া যোগ করা হয়নি।</td></tr></tbody></table></div></div>
</section>

<section id="rent" class="panel">
 <h2>মাসিক ভাড়া ও বিলের হিসাব</h2>
 <div class="card">
  <div class="formgrid">
   <div class="field"><label>ভাড়াটিয়া *</label><select id="rTenant"><option value="">ভাড়াটিয়া নির্বাচন করুন</option></select></div>
   <div class="field"><label>মাসের নাম</label><input id="rMonthName" value="January"></div>
   <div class="field"><label>বছর (২০০৬–২০৫৫)</label><select id="rYear"></select></div>
   <div class="field"><label>মাসিক ভাড়া (৳)</label><input id="rRent" type="number" min="0"></div>
   <div class="field"><label>পূর্বের বকেয়া (৳)</label><input id="rOldDue" type="number" min="0" value="0"></div>
